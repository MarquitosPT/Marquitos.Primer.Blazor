@inherits LayoutComponentBase

    <div class="page">

    <div class="middle">
        <div class="menu-toggle toggle">
                <Box BackgroundColor="BackgroundColor.Inset"
                     BorderColor="BorderColor.Default"
                     BorderStyle="BorderStyle.Solid"
                     BorderBlockEndWidth="BorderWidth.Thin">
                    <Stack Direction="Direction.Horizontal"
                           Padding="PaddingSize.P8">
                        <button type="button" class="btn " onclick="document.querySelectorAll(['.toggle']).forEach(item => item.classList.toggle('open'))">
                            ☰
                        </button>
                    </Stack>
                </Box>
        </div>
        
        <Box BackgroundColor="BackgroundColor.Inset"
             BorderColor="BorderColor.Default"
             BorderStyle="BorderStyle.Solid"
             BorderInlineEndWidth="BorderWidth.Thin">
            <aside class="toggle sidebar">
                <Box BackgroundColor="BackgroundColor.Inset">
                <div class="d-flex flex-justify-center">
                    <a class="navbar-brand" href="">
                        <img src="/logo.png" height="150" />
                    </a>
                </div>
                <nav class="nav flex-column" onclick="document.querySelectorAll(['.toggle']).forEach(item => item.classList.remove('open'))">
                    <div class="nav-item">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-house-door-fill" viewBox="0 0 16 16">
                                <path d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5" />
                            </svg>
                            <span class="nav-item-text">Home</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="layout">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-speedometer" viewBox="0 0 16 16">
                                <path d="M8 2a.5.5 0 0 1 .5.5V4a.5.5 0 0 1-1 0V2.5A.5.5 0 0 1 8 2M3.732 3.732a.5.5 0 0 1 .707 0l.915.914a.5.5 0 1 1-.708.708l-.914-.915a.5.5 0 0 1 0-.707M2 8a.5.5 0 0 1 .5-.5h1.586a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 8m9.5 0a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 0 1H12a.5.5 0 0 1-.5-.5m.754-4.246a.39.39 0 0 0-.527-.02L7.547 7.31A.91.91 0 1 0 8.85 8.569l3.434-4.297a.39.39 0 0 0-.029-.518z" />
                                <path fill-rule="evenodd" d="M6.664 15.889A8 8 0 1 1 9.336.11a8 8 0 0 1-2.672 15.78zm-4.665-4.283A11.95 11.95 0 0 1 8 10c2.186 0 4.236.585 6.001 1.606a7 7 0 1 0-12.002 0" />
                            </svg>
                            <span class="nav-item-text">Layout</span>
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="about">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                                <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0" />
                            </svg>
                            <span class="nav-item-text">About</span>
                        </NavLink>
                    </div>
                    
                </nav>
                </Box>
            </aside>
        </Box>
        <main class="main">
            <div class="menu-bar">
                    <Box
                        BackgroundColor="BackgroundColor.Inset"
                        BorderColor="BorderColor.Default"
                        BorderStyle="BorderStyle.Solid"
                        BorderBlockEndWidth="BorderWidth.Thin">
                        <Stack Direction="Direction.Horizontal"
                               HorizontalAlignment="HorizontalAlignment.End"
                               Padding="PaddingSize.P8"
                               Spacing="SpacingSize.P8">
                            <ThemeToggler />
                        </Stack>
                    </Box>
            </div>  

            <div class="content">
                @Body
            </div>
        </main>
        
    </div>

    <footer class="footer">
            <Box
                BackgroundColor="BackgroundColor.Inset"
                BorderColor="BorderColor.Default"
                BorderStyle="BorderStyle.Solid"
                BorderBlockStartWidth="BorderWidth.Thin"
                Padding="PaddingSize.P4">
                <strong>Marquitos Primer Blazor</strong> &copy; @DateTime.Now.Year by MarquitosPT
            </Box>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
