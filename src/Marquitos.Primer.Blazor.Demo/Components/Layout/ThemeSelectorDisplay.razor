@using Marquitos.Primer.Blazor.Services
@rendermode InteractiveServer

<Stack
    Direction="Direction.Horizontal"
    HorizontalAlignment="HorizontalAlignment.End"
    Padding="PaddingSize.P8"
    Spacing="SpacingSize.P8">
    <button type="button" class="btn" @onclick="ButtonLightClick">Light Theme</button>
    <button type="button" class="btn" @onclick="ButtonDarkClick">Dark Theme</button>
</Stack>

@code {
    [Inject]
    private ThemeStorageService ThemeService { get; set; } = default!;

    private async Task ButtonLightClick(MouseEventArgs args)
    {
        await ThemeService.SetThemeColorAsync(ThemeColor.Light);
    }

    private async Task ButtonDarkClick(MouseEventArgs args)
    {
        await ThemeService.SetThemeColorAsync(ThemeColor.Dark);
    }
}
